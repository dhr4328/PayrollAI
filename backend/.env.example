# PayrollAI - Environment Configuration
# Note: For security in production / CI/CD, set NVIDIA_API_KEY as a GitHub Secret (secrets.NVIDIA_API_KEY)

# AI API Key (Supports NVIDIA_API_KEY, OPENAI_API_KEY, or GEMINI_API_KEY)
NVIDIA_API_KEY=your_nvidia_api_key_here

# AI Model Configuration
NVIDIA_MODEL=nvidia/nemotron-4-340b-instruct
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
